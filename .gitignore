# Local Apple / AltServer installers — do not publish
iCloudSetup.exe
iTunes64Setup.exe
altinstaller/

# Nested third-party kit with its own .git + generated WebKit
ign/*
!ign/setup-ios-webview-debug.ps1
!ign/start-ios-webview-debug.ps1

# Python
**/__pycache__/
*.pyc
.venv/

# Clash controller API secret, local installer, and Verge profiles — do not publish
Clash/profiles/
Clash/*.exe

# USB watcher runtime log
altserver_refresh/iphone-usb-altserver.log

# iloader installer kept next to sidestore/README.md
sidestore/*.msi

# zsign/: the shared signing kit is tracked; zsign.exe (downloaded), SideStore's signing.p12 (a signing
# key) and zsign's cache stay on the machine
zsign/*
!zsign/README.md
!zsign/SideStoreSigning.ps1
!zsign/sidestore_sign.py
*.p12
.zsign_cache/
